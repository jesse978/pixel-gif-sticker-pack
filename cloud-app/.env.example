# Server only. Never put this key in web/assets or commit .env.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_IMAGE_MODEL=gpt-image-1.5

# Enable when serving via HTTPS. Keep false for the local HTTP preview.
STICKER_SECURE_COOKIE=false
# Files expire after this period (plus up to 30 seconds for cleanup).
STICKER_TTL_SECONDS=3600
# Optional absolute directory for temporary jobs; never use the static web directory.
# STICKER_DATA_DIR=/workspace/sticker-runtime
# Optional replacement for the bundled Noto CJK font.
# STICKER_FONT_PATH=/path/to/font.otf
